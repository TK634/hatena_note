# ===== WordPress（任意） =====
WP_URL=https://your-site.com
WP_USERNAME=admin
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx   # 管理画面 > ユーザー > アプリケーションパスワードで生成

# ===== X(Twitter) API =====
TWITTER_API_KEY=xxxxxxxx
TWITTER_API_SECRET=xxxxxxxx
TWITTER_ACCESS_TOKEN=xxxxxxxx
TWITTER_ACCESS_SECRET=xxxxxxxx

# ===== Threads(Meta) API =====
THREADS_ACCESS_TOKEN=xxxxxxxx
THREADS_USER_ID=xxxxxxxx

# ===== Instagram Graph API =====
INSTAGRAM_ACCESS_TOKEN=xxxxxxxx
INSTAGRAM_ACCOUNT_ID=xxxxxxxx
CLOUDINARY_OGP_URL=https://res.cloudinary.com/your-cloud/image/upload/latest-ogp.png

# ===== note.com =====
NOTE_EMAIL=your@email.com
NOTE_PASSWORD=xxxxxxxx

# ===== Webダッシュボード（dashboard/） =====
# モバイル対応の管理画面。Basic認証のユーザー名・パスワード（両方設定した場合のみ認証がかかる）
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=xxxxxxxxxxxxxxxxxxxx

# ===== アフィリエイトIDメモ =====
# 1. A8.net (https://www.a8.net/) に登録
# 2. 各プログラムに参加申請
# 3. 広告リンクを取得して genres.ts の REPLACE_XXXXX を置き換える
# 4. Amazon アソシエイト (https://affiliate.amazon.co.jp/) に登録
#    → タグID取得後 genres.ts の REPLACE-22 を your-tag-22 に置き換える
